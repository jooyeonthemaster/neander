rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 관리자 이메일 검증 함수
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'ok@neander.co.kr',
          'admin@neander.co.kr',
          'nadr110619@gmail.com'
        ];
    }

    match /popups/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /news/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /portfolio/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
